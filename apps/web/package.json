{
  "name": "void-market-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host localhost --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host localhost --port 3000 --strictPort",
    "check": "tsc --noEmit && prettier --check src tests index.html vite.config.ts playwright.config.ts",
    "format": "prettier --write src tests index.html vite.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
