# Non-secret settings. Export before every localnet Compose helper command:
# set -a
# . deploy/voidmarket.dev/runtime.env
# set +a
# python3 scripts/localnet/compose.py up --state /var/lib/void-market
# Keep generated credentials and chain state in that private state directory.

ORIGIN=https://voidmarket.dev
RP_ID=voidmarket.dev
COMPOSE_PROJECT_NAME=void-market-demo

# Compose binds every published application/RPC port to 127.0.0.1.
WEB_PORT=3100
HTTP_PORT=8180
ETHEREUM_RPC_PORT=18545
ZCASH_RPC_PORT=18332
