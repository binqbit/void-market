# Nonsecret local-development configuration. Copy to docker/market.env later.
HTTP_PORT=8080
WEB_PORT=3000
ORIGIN=http://localhost:3000
RP_ID=localhost
EVENT_TOPIC=dev.voidmarket.assets.events.v1
NODE_EVENT_TOPIC=dev.voidmarket.nodes.v1
GOOGLE_CLIENT_ID=

# Supply JWT_SECRET and GOOGLE_CLIENT_SECRET through the
# invoking environment or a secret manager. Generate a stable JWT secret
# with at least 32 random bytes; retain it across restarts.
# Google redirect URI: http://localhost:3000/api/v1/auth/google/callback

# Set once before first startup; retain the value with the broker volume.
KAFKA_CLUSTER_ID=

# Supply DATABASE_PASSWORD through the invoking environment/secret manager.
# It is deliberately absent from this file.
