# Nonsecret local-development configuration. Copy to docker/market.env later.
MARKET_HTTP_PORT=8080
MARKET_ORIGIN=http://localhost:3000
MARKET_RP_ID=localhost
MARKET_EVENT_TOPIC=dev.voidmarket.assets.events.v1

# Set once before first startup; retain the value with the broker volume.
KAFKA_CLUSTER_ID=

# Supply MARKET_DATABASE_PASSWORD through the invoking environment/secret manager.
# It is deliberately absent from this file.
