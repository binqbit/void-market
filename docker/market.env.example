# Nonsecret local-development configuration. Copy to docker/market.env later.
HTTP_PORT=8080
WEB_PORT=3000
ORIGIN=http://localhost:3000
RP_ID=localhost
EVENT_TOPIC=dev.voidmarket.assets.events.v1
NODE_EVENT_TOPIC=dev.voidmarket.nodes.v1
GOOGLE_CLIENT_ID=

# Supply GOOGLE_CLIENT_SECRET through the invoking environment or a secret manager.
# Compose mounts a stable JWT secret from a file with at least 32 random bytes.
# Keep it in an owner-only host directory, readable by the container service UID.
JWT_SECRET_FILE=
# Google redirect URI: http://localhost:3000/api/v1/auth/google/callback

# Set once before first startup; retain the value with the broker volume.
KAFKA_CLUSTER_ID=

# Compose mounts the database password from an owner-only host directory.
# The file must be readable by PostgreSQL and the application container UIDs.
DATABASE_PASSWORD_FILE=

# Development custody is optional and never enabled implicitly.
DEV_CUSTODY=false
CUSTODY_MASTER_KEY_FILE=
CUSTODY_ARTIFACT_ROOT=

# Required only by compose.custody.yaml; point at the intended development media directory.
DEV_MEDIA_ROOT=
