# Merge with .env when using compose.yaml + compose.arbiter.yaml.
# Generate a node identity explicitly with: arbiter identity <private-directory>
# Provision its node.json with: market provision-node <node.json>
NODE_ID=
DEPLOYMENT_ID=
ARBITER_SIGNING_KEY_FILE=
ARBITER_SERVICE_TOKEN_FILE=
ARBITER_ARTIFACT_ROOT=
ARBITER_DATABASE_PASSWORD=
LOCAL_UID=1000
LOCAL_GID=1000

# Native runtime uses these service-local names instead of Compose host names:
# DATABASE_URL=postgres://arbiter:<password>@127.0.0.1:5432/arbiter
# GATEWAY_URL=https://your-market-origin
# GATEWAY_CA_FILE=/private/market-ca.pem
# SIGNING_KEY_FILE=/private/signing.key
# SERVICE_TOKEN_FILE=/private/service.token
# ARTIFACT_ROOT=/private/artifacts
# LOCAL_DEMO=true explicitly enables unverified honest-role mechanics and loopback HTTP.
# Strict mode reports the unfinished proof capability as unavailable.
