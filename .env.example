# Local Docker Compose configuration. Copy to .env and keep .env private.
HTTP_PORT=8080
WEB_PORT=3000
ORIGIN=http://localhost:3000
RP_ID=localhost
EVENT_TOPIC=dev.voidmarket.assets.events.v1
NODE_EVENT_TOPIC=dev.voidmarket.nodes.v1

# Google OAuth: create a Web application client in Google Auth Platform.
# Authorized redirect URI: http://localhost:3000/api/v1/auth/google/callback
# Leave both values empty to keep Google sign-in disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# File-backed Compose secrets work with read-only service containers.
# The full-demo helper creates these automatically in its private state directory.
# For the base stack, create them once and retain across restarts:
# install -d -m 0700 .localnet/secrets
# (umask 077; openssl rand -hex 24 > .localnet/secrets/database_password)
# (umask 077; openssl rand -hex 32 > .localnet/secrets/jwt_secret)
# chmod 0444 .localnet/secrets/database_password .localnet/secrets/jwt_secret
# The 0700 directory protects the host copies; mounted files must be readable by service UIDs.
DATABASE_PASSWORD_FILE=./.localnet/secrets/database_password
JWT_SECRET_FILE=./.localnet/secrets/jwt_secret
# Kafka cluster ID: a URL-safe base64 UUID without padding.
KAFKA_CLUSTER_ID=

# Optional development custody: the market owns user signing/HE keys.
# The 32-byte master key must be retained, private (0600), and outside public assets.
DEV_CUSTODY=false
CUSTODY_MASTER_KEY_FILE=
# Must be the same private artifact directory as ARTIFACT_ROOT on the arbiter.
CUSTODY_ARTIFACT_ROOT=

# Required only by compose.custody.yaml; point at the intended development media directory.
DEV_MEDIA_ROOT=

# Optional local-chain demo. Normally use scripts/localnet/compose.py up.
DEMO_MODE=false
ETHEREUM_RPC_URL=http://127.0.0.1:8545
ZCASH_NODE_RPC_URL=http://127.0.0.1:18232
ZCASH_WALLET_RPC_URL=http://127.0.0.1:28232
ZCASH_WALLET_COOKIE_FILE=
