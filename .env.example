# Local Docker Compose configuration. Copy to .env and keep .env private.
HTTP_PORT=8080
WEB_PORT=3000
ORIGIN=http://localhost:3000
RP_ID=localhost
EVENT_TOPIC=dev.voidmarket.assets.events.v1
NODE_EVENT_TOPIC=dev.voidmarket.nodes.v1

# Google OAuth: create a Web application client in Google Auth Platform.
# Authorized redirect URI: http://localhost:3000/api/v1/auth/google/callback
# Leave both values empty to keep Google sign-in disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate once and retain across restarts.
# Database password: openssl rand -hex 24
DATABASE_PASSWORD=
# JWT signing secret: openssl rand -hex 32
JWT_SECRET=
# Kafka cluster ID: a URL-safe base64 UUID without padding.
KAFKA_CLUSTER_ID=

# Optional development custody: the market owns user signing/HE keys.
# The 32-byte master key must be retained, private (0600), and outside public assets.
DEV_CUSTODY=false
CUSTODY_MASTER_KEY_FILE=
# Must be the same private artifact directory as ARTIFACT_ROOT on the arbiter.
CUSTODY_ARTIFACT_ROOT=

# Required only by compose.custody.yaml; point at the intended development media directory.
DEV_MEDIA_ROOT=
